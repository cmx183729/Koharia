CREATE TABLE local_library_item (
    source_id INTEGER NOT NULL,
    item_key TEXT NOT NULL,
    root_id TEXT NOT NULL,
    relative_path TEXT NOT NULL,
    content_type TEXT NOT NULL,
    kind TEXT NOT NULL,
    format TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    fingerprint TEXT,
    locator_path TEXT NOT NULL,
    document_identity TEXT,
    folder_identity TEXT,
    missing INTEGER NOT NULL DEFAULT 0,
    image_comic INTEGER NOT NULL DEFAULT 0,
    image_comic_override INTEGER,
    virtual_type TEXT,
    backing_path TEXT,
    PRIMARY KEY (source_id, item_key)
);

CREATE INDEX local_library_item_location_index ON local_library_item(source_id, root_id, relative_path);

CREATE INDEX local_library_item_kind_index ON local_library_item(source_id, root_id, kind, missing);

CREATE INDEX local_library_item_fingerprint_index ON local_library_item(source_id, fingerprint);

CREATE TABLE local_library_pending_refresh (
    source_id INTEGER NOT NULL,
    item_key TEXT NOT NULL,
    PRIMARY KEY (source_id, item_key)
);

CREATE TABLE local_library_meta (
    source_id INTEGER NOT NULL PRIMARY KEY,
    scanned_at INTEGER NOT NULL DEFAULT 0,
    schema_version INTEGER NOT NULL DEFAULT 6,
    title_purge_regex TEXT NOT NULL DEFAULT '',
    folder_operation TEXT
);

getItems:
SELECT * FROM local_library_item WHERE source_id = :sourceId;

getPendingRefresh:
SELECT item_key FROM local_library_pending_refresh WHERE source_id = :sourceId;

getMeta:
SELECT scanned_at, schema_version, title_purge_regex, folder_operation
FROM local_library_meta
WHERE source_id = :sourceId;

putMeta:
INSERT OR REPLACE INTO local_library_meta(
    source_id,
    scanned_at,
    schema_version,
    title_purge_regex,
    folder_operation
)
VALUES (
    :sourceId,
    :scannedAt,
    :schemaVersion,
    :titlePurgeRegex,
    :folderOperation
);

putItem:
INSERT OR REPLACE INTO local_library_item(
    source_id,
    item_key,
    root_id,
    relative_path,
    content_type,
    kind,
    format,
    size_bytes,
    modified_at,
    fingerprint,
    locator_path,
    document_identity,
    folder_identity,
    missing,
    image_comic,
    image_comic_override,
    virtual_type,
    backing_path
)
VALUES (
    :sourceId,
    :itemKey,
    :rootId,
    :relativePath,
    :contentType,
    :kind,
    :format,
    :sizeBytes,
    :modifiedAt,
    :fingerprint,
    :locatorPath,
    :documentIdentity,
    :folderIdentity,
    :missing,
    :imageComic,
    :imageComicOverride,
    :virtualType,
    :backingPath
);

removeItems:
DELETE FROM local_library_item WHERE source_id = :sourceId AND item_key IN :itemKeys;

clearItems:
DELETE FROM local_library_item WHERE source_id = :sourceId;

putPendingRefresh:
INSERT OR REPLACE INTO local_library_pending_refresh(source_id, item_key) VALUES (:sourceId, :itemKey);

removePendingRefresh:
DELETE FROM local_library_pending_refresh WHERE source_id = :sourceId AND item_key IN :itemKeys;

clearPendingRefresh:
DELETE FROM local_library_pending_refresh WHERE source_id = :sourceId;

clearMeta:
DELETE FROM local_library_meta WHERE source_id = :sourceId;
